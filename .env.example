# 이 파일을 복사해 .env 로 저장하고 실제 키를 채워넣으세요.
# .env 는 .gitignore에 포함되어 있어 깃에 올라가지 않습니다.
# 아래 네 공급자 중 쓸 것만 채우면 됩니다 — 비워둔 공급자는 AI 어시스턴트에서
# 선택했을 때 방문자(또는 본인)에게 개인 키 입력을 요청합니다.

# ── Gemini — https://aistudio.google.com/apikey ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Claude (Anthropic) — https://console.anthropic.com/settings/keys ──
ANTHROPIC_API_KEY=

# ── GPT (OpenAI) — https://platform.openai.com/api-keys ──
OPENAI_API_KEY=

# ── 회사 전용 LLM (OpenAI 호환 /chat/completions 엔드포인트 전제) ──
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# 선택 사항 — 비워두면 기본값(8899) 사용
PORT=8899
